# 复制为 .env 并导出到当前 shell，或写入 application-local.yml（profile=local）。
# 进程不会自动加载本文件。真实 Key 不要入库。
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# 对照入口 dream-scope-boot 换厂商：agentscope.model.provider=openai|anthropic|gemini|ollama
# 可选：ModelRegistry 字符串。chat 优先，空白则用 DEFAULT。
DREAM_SCOPE_MODEL_DEFAULT=dashscope:qwen-plus
DREAM_SCOPE_MODEL_CHAT=dashscope:qwen-plus
# 可选：不配则用模型默认
# DREAM_SCOPE_MODEL_TEMPERATURE=0.7
# DREAM_SCOPE_MODEL_TOP_P=0.8
# DREAM_SCOPE_MODEL_MAX_TOKENS=2048
# 可选备用模型（与主模型不同才会启用）
# DREAM_SCOPE_MODEL_FALLBACK=dashscope:qwen-turbo
# knowledge 当前只检索、不调模型。预留：
DREAM_SCOPE_MODEL_KNOWLEDGE=dashscope:qwen-plus
# 观测：配了才向 OTLP 导 trace（未配则 OtelTracingMiddleware 为空操作）
# OTEL_SERVICE_NAME=dream-scope
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_EXPORTER=otlp
# Redis 必选。本地：docker compose up -d redis
DREAM_SCOPE_REDIS_URI=redis://127.0.0.1:6379
DREAM_SCOPE_REDIS_KEY_PREFIX=dream-scope:
# Nacos 3.x。默认全关；开了才连，没起 Nacos 会起不来。
# docker compose up -d nacos
# NACOS_SERVER_ADDR=127.0.0.1:8848
# NACOS_USERNAME=
# NACOS_PASSWORD=
# AI（gRPC 9848）：prompt / A2A
# DREAM_SCOPE_NACOS_ENABLED=true
# NACOS_NAMESPACE=public
# 配置中心 / 服务发现（HTTP 8848，Spring Cloud Alibaba）
# DREAM_SCOPE_NACOS_CONFIG_ENABLED=true
# DREAM_SCOPE_NACOS_DISCOVERY_ENABLED=true
# NACOS_CLOUD_NAMESPACE=
# Prompt：Nacos AI 里建 key=dream-scope-chat 的模板，拼在内置 SYS_PROMPT 后面。改模板后要重启。
# DREAM_SCOPE_NACOS_PROMPT_ENABLED=true
# DREAM_SCOPE_NACOS_PROMPT_SYS_PROMPT_KEY=dream-scope-chat
# A2A 注册到 Nacos / 从 Nacos 发现（agentId=a2a）。发现名默认 dream-scope-chat。
# DREAM_SCOPE_NACOS_A2A_REGISTRY_ENABLED=true
# DREAM_SCOPE_NACOS_A2A_DISCOVERY_ENABLED=true
# DREAM_SCOPE_NACOS_A2A_DISCOVERY_AGENT_NAME=dream-scope-chat
# 对照入口 boot：agentscope.a2a.nacos.enabled=true 且 agentscope.nacos.prompt.enabled=true
# 配置中心 / 发现与 web 共用 DREAM_SCOPE_NACOS_CONFIG_ENABLED / DREAM_SCOPE_NACOS_DISCOVERY_ENABLED
# Plan Mode 默认开。模型可自行 plan_enter；无人审 HTTP。关：
# DREAM_SCOPE_PLAN_MODE_ENABLED=false
# DREAM_SCOPE_PLAN_MODE_DIRECTORY=plans
# MCP：dream-scope.mcp.servers 走 McpClientBuilder（stdio / sse / streamableHttp），不写 tools.json。
# RAG：auto（默认）有 DASHSCOPE_API_KEY 用官方 SimpleKnowledge，embedding 失败则回退关键词。强制：
# DREAM_SCOPE_RAG_PROVIDER=keyword
# DREAM_SCOPE_RAG_PROVIDER=simple
# A2A。关本机 Card /a2a：DREAM_SCOPE_A2A_ENABLED=false
# DREAM_SCOPE_A2A_PUBLIC_URL=http://127.0.0.1:8091
# 非空则注册 agentId=a2a 调远端：
# DREAM_SCOPE_A2A_REMOTE_URL=
