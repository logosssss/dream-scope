# dream-scope-boot 环境变量。复制为同目录 .env 后，在启动前导入当前 shell。
# Spring Boot 不会自动读这个文件。真实密钥不要入库。
# 默认厂商是 dashscope。DASHSCOPE_API_KEY 为空时，创建 Model 会失败，进程起不来。

DASHSCOPE_API_KEY=

# 换厂商时再打开对应项，并改 application.yml：
# agentscope.model.provider 设成该厂商，只把这一家 enabled 设为 true。
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# 知识库。向量和对话共用 DASHSCOPE_API_KEY。
# 密钥为空：只做关键词检索。
# 只有密钥、没有下面的 JDBC：关键词没命中时用内存向量补。
# 密钥和 JDBC 都有：向量写入 PostgreSQL 表 dream_scope_boot_rag。库不存在时会连 postgres 建库。
# DREAM_SCOPE_RAG_PG_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/dream_scope
# DREAM_SCOPE_RAG_PG_USERNAME=postgres
# DREAM_SCOPE_RAG_PG_PASSWORD=postgres

# 主模型失败时的备用。空则不切换。与主模型同名则忽略。未写下面这项时用 DASHSCOPE_API_KEY。
# DREAM_SCOPE_MODEL_FALLBACK=dashscope:qwen-turbo
# DREAM_SCOPE_MODEL_FALLBACK_API_KEY=

# 对话会话必须连 Redis。默认本机 6379，键前缀 dream-scope-boot:，与 web 的 dream-scope: 分开。
# userId 和 sessionId 要成对带上才会续聊。连不上则对话 Agent 起不来。
# DREAM_SCOPE_REDIS_URI=redis://127.0.0.1:6379

# Nacos 默认关闭。配置中心、服务发现、AI prompt、A2A 注册、技能库都要显式打开才会连。
# NACOS_SERVER_ADDR=127.0.0.1:8848
# NACOS_USERNAME=
# NACOS_PASSWORD=
# NACOS_NAMESPACE=
# NACOS_CLOUD_NAMESPACE=
# DREAM_SCOPE_NACOS_CONFIG_ENABLED=false
# DREAM_SCOPE_NACOS_DISCOVERY_ENABLED=false
# 技能库：application.yml 里 agentscope.nacos.skill.enabled=true，技能名写在 names。
# NACOS_NAMESPACE 对应 agentscope.nacos.skill.namespace，空则用 public。
# A2A 客户端：application.yml 里 agentscope.a2a.client.enabled=true。
# url 空着时用 http://127.0.0.1:8092，也就是本进程的 Agent Card。
# 打开后 POST /api/a2a/invoke 把 input 发给该地址上的 Agent。创建客户端时不访问远端。
